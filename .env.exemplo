# Copie pra `.env` e preencha. O `.env` está no .gitignore e NÃO pode ser commitado.
#
# Gere a CHAVE_SEGREDO com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Ela cifra o token de acesso das lojas no banco. Se você trocar essa chave, os
# tokens já guardados param de abrir e todas as lojas precisam reinstalar o app —
# então gere uma vez e guarde bem.
CHAVE_SEGREDO=

# Do painel do app, em "Client credentials".
#
# ATENÇÃO: cole só o VALOR, mantendo o nome antes do `=`. Colar por cima da linha
# inteira apaga o nome da variável, e o app sobe achando que o segredo não existe.
SHOPIFY_CHAVE_API=
SHOPIFY_SEGREDO=

# Só durante uma rotação de Client secret, e depois esvazie.
#
# Ao rotacionar, o Shopify gera o novo e CONTINUA ASSINANDO COM O ANTIGO até você
# concluir a rotação no painel. Sem isto, a janela inteira fica com webhook,
# instalação e token de sessão sendo recusados — sem motivo visível.
#
# Aqui ele é aceito pra CONFERIR o que chega. O que o app assina sai sempre com o
# atual. Segredo antigo esquecido no ambiente é um segredo válido a mais pra vazar.
SHOPIFY_SEGREDO_ANTIGO=

# A URL pública do app, https, SEM barra no fim. Precisa ser exatamente igual à
# cadastrada no painel do Shopify — o OAuth recusa por diferença de um caractere.
APP_URL=https://etiquetas.exemplo.com

# Não existe COBRANCA_TESTE: o app pergunta ao Shopify se a loja é de
# desenvolvimento na hora de assinar. Ver `loja/cobranca.py`.

# Onde fica o SQLite. Em hospedagem com disco efêmero, aponte pro volume
# persistente — senão cada reinício apaga as lojas instaladas.
BANCO_CAMINHO=etiquetas.db

# 1 solta as exigências pra rodar no computador sem credencial. NUNCA em produção.
MODO_DEV=0

# Aparecem na política de privacidade, que é pública. Use um e-mail que você
# realmente lê: a loja de apps do Shopify exige contato de suporte, e um pedido
# de exclusão de dados sem resposta em 30 dias é problema regulatório.
CONTATO_EMAIL=
CONTATO_NOME=
# Onde o app roda. Precisa estar na política, porque é um subprocessador.
HOSPEDAGEM=

# Só quando a hospedagem obriga a saída a passar por um proxy. No plano grátis do
# PythonAnywhere é `http://proxy.server:3128` — e sem isto o app sobe e falha em
# TODA chamada ao Shopify, com erro de conexão e nada dizendo que o motivo é
# proxy. Vazio = conexão direta, que é o caso de qualquer servidor normal.
PROXY_SAIDA=
